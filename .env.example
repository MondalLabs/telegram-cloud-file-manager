
# ══ SECRETS — Never share or commit these values ══════════════════════════════
# Get API_ID and API_HASH from https://my.telegram.org/apps
API_ID=your_api_id_from_my.telegram.org
API_HASH=your_api_hash_from_my.telegram.org
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=your_bot_token_from_@BotFather
# Get MONGO_URI from MongoDB Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/

# ══ DEPLOYMENT ════════════════════════════════════════════════════════════════
# Your Telegram user ID (get it from @RawDataBot)
OWNER_ID=your_telegram_user_id
# Leave blank — the bot auto-detects this when you send /setup inside the dump group
DUMP_CHAT_ID=
# Port for the built-in health-check server (required by Render / Railway)
HEALTH_PORT=10000

# ══ PERSONALISATION ═══════════════════════════════════════════════════════════
# Your bot's display name. Shown in welcome and access-denied messages.
# Spaces are supported. Leave blank to use generic text (fully white-labelled).
# Example: BOT_NAME=Rudra's Private Drive
BOT_NAME=

# ══ PREFERENCES ═══════════════════════════════════════════════════════════════
# How many items to show per page in folder listings.
ITEMS_PER_PAGE=15
# true  = delivered files cannot be forwarded or saved by users (recommended).
# false = files are freely forwardable.
PROTECT_CONTENT=true
# Hours before a delivered file is auto-deleted from the user's chat.
# Set to 0 to disable auto-deletion entirely (files stay permanently).
# Decimals are allowed: 0.5 = 30 minutes, 2 = 2 hours.
AUTO_DELETE_HOURS=1
