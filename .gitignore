# ── Python runtime ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.so

# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Pyrofork / Pyrogram session files (NEVER commit these!) ──────────────────
# These files contain your authenticated MTProto session — treat like passwords
*.session
*.session-journal
cfm_bot.session
cfm_bot.session-journal

# ── Environment variables (contain API keys and credentials!) ─────────────────
.env
# .env.example is safe to commit — it has no real values

# ── Build / distribution ──────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Render / deployment artifacts ────────────────────────────────────────────
.render-buildpacks.json

# ── Temporary / scratch ───────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
